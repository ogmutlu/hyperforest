{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hyperforest",
  "version": "1.1.0",
  "identifier": "io.github.ogmutlu.hyperforest",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hyperforest",
        "width": 1300,
        "height": 900,
        "minWidth": 700,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "targets": [
      "deb",
      "appimage"
    ],
    "shortDescription": "Goals, focus, and notes in a local hyperforest",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
